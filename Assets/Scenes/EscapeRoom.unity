--- !u!114 &1014920562
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1014920561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fcf87d5e31bc4742bfe98758809aefa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneDialogueTrigger
  sceneLines:
  - speakerName: 'Dimitri '
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: '*I wake up in a hospital bed*'
  - speakerName: 'Roman '
    portrait: {fileID: 21300000, guid: 0b630fbfd946bf54bb3f9832a11bc528, type: 3}
    side: 1
    text: He's waking up.
  - speakerName: 'Silvia '
    portrait: {fileID: 21300000, guid: f7ab9e5d09f29b940b14a3047fcaa5f6, type: 3}
    side: 1
    text: Dimitri is waking up. I was worried he would not come back to us.
  - speakerName: 'Catherine '
    portrait: {fileID: 21300000, guid: c2c4910e134143b4684c05ed8d550841, type: 3}
    side: 1
    text: Finally awake, sleepy head.
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: 'Agghh, how long has it been since the last battle? '
  - speakerName: 'Silvia '
    portrait: {fileID: 21300000, guid: f7ab9e5d09f29b940b14a3047fcaa5f6, type: 3}
    side: 1
    text: 'About 4 hours. You passed out after the battle.  '
  - speakerName: Roman
    portrait: {fileID: 21300000, guid: 0b630fbfd946bf54bb3f9832a11bc528, type: 3}
    side: 1
    text: 'We carried you here after the fight. '
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: 'Really, thank you!. '
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: 'Have you figured anything out? '
  - speakerName: 'Catherine '
    portrait: {fileID: 21300000, guid: c2c4910e134143b4684c05ed8d550841, type: 3}
    side: 1
    text: ' No, not at all. That little brat refuses to talk to us, only to you.'
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: 'Who.. Luna? '
  - speakerName: 'Catherine '
    portrait: {fileID: 21300000, guid: c2c4910e134143b4684c05ed8d550841, type: 3}
    side: 1
    text: 'Is that her name? Whatever, she won''t talk to us, only to you; she''s
      in the next room over there. '
  triggerRadius: 2
  triggerMode: 0
  triggerOnce: 1
  advanceStageOnFinish: 0
  teleportDestination: {fileID: 0}
