  npcName: Dimitri????
  npcPortrait: {fileID: 21300000, guid: 10924731a072d374b97cb942e7cd5250, type: 3}
  dialogueStages:
  - stage: 0
    lines:
    - speakerName: DImitri
      portrait: {fileID: 0}
      side: 0
      text: Who or what are you?
    - speakerName: DImitri??????
      portrait: {fileID: 0}
      side: 1
      text: ' You already know the answer to this question.'
    - speakerName: DImitri
      portrait: {fileID: 0}
      side: 0
      text: No, you're not me, you can't be me, I look nothing like you!
    - speakerName: DImitri???????
      portrait: {fileID: 0}
      side: 1
      text: Yeah, on the outside, but I am you.
    - speakerName: DImitri
      portrait: {fileID: 0}
      side: 0
      text: How are you, me?
    - speakerName: DImitri???????
      portrait: {fileID: 0}
      side: 1
      text: ' You have fallen from grace. Channel that anger into this experiment
        you''ve gotten '
    - speakerName: DImitri???????
      portrait: {fileID: 0}
      side: 1
      text: 'What the hell is that supposed to mean? '
  triggerOnce: 1
  teleportDestination: {fileID: 503184076}
