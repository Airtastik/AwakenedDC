--- !u!114 &793933284
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 793933283}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fcf87d5e31bc4742bfe98758809aefa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneDialogueTrigger
  sceneLines:
  - speakerName: Dimitiri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: 'Dimitri: Are we finally out of here?'
  - speakerName: Dimitri Alter
    portrait: {fileID: 21300000, guid: 10924731a072d374b97cb942e7cd5250, type: 3}
    side: 1
    text: You're not finished.
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: What is that supposed to mean???
  - speakerName: 'Dimitri Alter '
    portrait: {fileID: 21300000, guid: 10924731a072d374b97cb942e7cd5250, type: 3}
    side: 1
    text: You haven't changed one bit since the experiment began.
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: What does that matter to you?
  - speakerName: Roman
    portrait: {fileID: 21300000, guid: 0b630fbfd946bf54bb3f9832a11bc528, type: 3}
    side: 1
    text: ' Look over there!'
  - speakerName: Luna
    portrait: {fileID: 21300000, guid: 053fc742baa0af94daca4893be7aca6d, type: 3}
    side: 1
    text: "We are not finished yet. The \u201CHospital\u201D has one more trick up
      its sleeve."
  - speakerName: SIlvia
    portrait: {fileID: 21300000, guid: f7ab9e5d09f29b940b14a3047fcaa5f6, type: 3}
    side: 1
    text: ' A bunch of enemies have appeared!'
  - speakerName: Catherene
    portrait: {fileID: 21300000, guid: c2c4910e134143b4684c05ed8d550841, type: 3}
    side: 1
    text: ' Dang it! We are so close to getting out of this hellhole!'
  - speakerName: Luna
    portrait: {fileID: 21300000, guid: 053fc742baa0af94daca4893be7aca6d, type: 3}
    side: 1
    text: ................
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: Luna, what's on your mind? Do you think you know a way out of here?
  - speakerName: Luna
    portrait: {fileID: 21300000, guid: 053fc742baa0af94daca4893be7aca6d, type: 3}
    side: 1
    text: ' I think I can create a path out. I just need some time.'
  - speakerName: Dimitri
    portrait: {fileID: 21300000, guid: 30f65458f3f60904b9d160f5d1c01360, type: 3}
    side: 0
    text: We can get you that time. Everyone protect Luna!
  triggerRadius: 4
  triggerMode: 0
  triggerOnce: 1
  advanceStageOnFinish: 0
  teleportDestination: {fileID: 0}
