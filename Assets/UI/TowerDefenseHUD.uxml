<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/TowerDefenseHUD.uss?fileID=7433441132597879392&amp;guid=ab1fdaca954abe74cbc247af8b3a5cd1&amp;type=3#TowerDefenseHUD"/>
    <ui:VisualElement name="hud-root" class="hud-root">
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement class="stat-pill health-pill">
                <ui:Label text="♥" class="stat-icon health-icon"/>
                <ui:Label name="health-value" text="100" class="stat-value"/>
                <ui:Label text="HP" class="stat-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill wave-pill">
                <ui:Label text="⚑" class="stat-icon wave-icon"/>
                <ui:Label name="wave-value" text="1 / 5" class="stat-value"/>
                <ui:Label text="WAVE" class="stat-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill enemy-pill">
                <ui:Label text="☠" class="stat-icon enemy-icon"/>
                <ui:Label name="enemy-value" text="0" class="stat-value"/>
                <ui:Label text="LEFT" class="stat-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill currency-pill">
                <ui:Label text="◈" class="stat-icon currency-icon"/>
                <ui:Label name="currency-value" text="500" class="stat-value"/>
                <ui:Label text="CREDITS" class="stat-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-bar" class="bottom-bar">
            <ui:VisualElement name="tower-shop" class="tower-shop">
                <ui:Label text="TOWERS" class="shop-label"/>
                <ui:VisualElement name="tower-btn-1" class="tower-btn">
                    <ui:VisualElement class="tower-icon t1-icon" style="background-color: rgb(220, 20, 60); border-left-color: rgb(205, 92, 92); border-right-color: rgb(205, 92, 92); border-top-color: rgb(205, 92, 92); border-bottom-color: rgb(205, 92, 92);"/>
                    <ui:Label text="CATHERINE" class="tower-name"/>
                    <ui:Label text="100" class="tower-cost"/>
                    <ui:Label text="[1]" class="tower-hotkey"/>
                </ui:VisualElement>
                <ui:VisualElement name="tower-btn-2" class="tower-btn">
                    <ui:VisualElement class="tower-icon t2-icon" style="background-color: rgb(60, 112, 180); border-left-color: rgb(154, 187, 245); border-right-color: rgb(154, 187, 245); border-top-color: rgb(154, 187, 245); border-bottom-color: rgb(154, 187, 245);"/>
                    <ui:Label text="ROMAN" class="tower-name"/>
                    <ui:Label text="150" class="tower-cost"/>
                    <ui:Label text="[2]" class="tower-hotkey"/>
                </ui:VisualElement>
                <ui:VisualElement name="tower-btn-3" class="tower-btn">
                    <ui:VisualElement class="tower-icon t3-icon" style="background-color: rgb(46, 226, 69); border-left-color: rgb(167, 238, 165); border-right-color: rgb(167, 238, 165); border-top-color: rgb(167, 238, 165); border-bottom-color: rgb(167, 238, 165);"/>
                    <ui:Label text="SILVIA" class="tower-name"/>
                    <ui:Label text="200" class="tower-cost"/>
                    <ui:Label text="[3]" class="tower-hotkey"/>
                </ui:VisualElement>
                <ui:VisualElement name="tower-btn-4" class="tower-btn">
                    <ui:VisualElement class="tower-icon t4-icon" style="background-color: rgb(190, 186, 28);"/>
                    <ui:Label text="DIMITRI" class="tower-name"/>
                    <ui:Label text="250" class="tower-cost"/>
                    <ui:Label text="[4]" class="tower-hotkey"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="upgrade-panel" class="upgrade-panel hidden">
                <ui:VisualElement class="upgrade-header">
                    <ui:Label name="upgrade-tower-name" text="CATHERINE" class="upgrade-title"/>
                    <ui:Label name="upgrade-level" text="LVL 1" class="upgrade-level-badge"/>
                </ui:VisualElement>
                <ui:VisualElement class="upgrade-stats">
                    <ui:Label name="upgrade-range" text="RNG  5" class="upgrade-stat"/>
                    <ui:Label name="upgrade-damage" text="DMG  10" class="upgrade-stat"/>
                </ui:VisualElement>
                <ui:VisualElement class="upgrade-actions">
                    <ui:Button name="upgrade-btn" text="UPGRADE  ◈ 150" class="upgrade-btn"/>
                    <ui:Button name="sell-btn" text="SELL  ◈ 50" class="sell-btn"/>
                    <ui:Button name="deselect-btn" text="✕" class="deselect-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="btn-start-wave" text="Start Wave" class="start-button" style="text-overflow: clip; color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
        <ui:Label name="wave-message" text="" class="wave-message hidden"/>
    </ui:VisualElement>
</ui:UXML>
