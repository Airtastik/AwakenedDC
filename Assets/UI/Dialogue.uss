/* ═══════════════════════════════════════════════════
   Dialogue.uss  —  Dialogue UI stylesheet
   Matches RPGins dark theme: near-black bg, gold accents
   ═══════════════════════════════════════════════════ */

/* ── Root overlay ──────────────────────────────────── */
.dialogue-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.dialogue-root.hidden {
    display: none;
}

/* ── Character sprites ─────────────────────────────── */
.sprite-frame {
    position: absolute;
    bottom: 0%;
    width: 18%;
    height: 52%;
}

.sprite-left  { left: -20%;}
.sprite-right { right: 20%; }

.sprite-img {
    width: 300%;
    height: 300%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Dim inactive speaker — same feel as fainted-card */
.sprite-frame.inactive {
    opacity: 0.35;
}

/* ── Dialogue box ──────────────────────────────────── */
.dialogue-box {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 2%;
    min-height: 18%;
    background-color: rgba(22, 27, 34, 0.97);
    border-color: rgb(240, 192, 64);
    border-width: 1px;
    border-radius: 6px;
    padding: 14px 18px 8px 18px;
    flex-direction: column;
}

/* ── Speaker name tab ──────────────────────────────── */
.speaker-name {
    position: absolute;
    top: -13px;
    left: 14px;
    background-color: rgb(240, 192, 64);
    color: rgb(13, 17, 23);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 2px 10px;
    border-radius: 4px;
}

/* ── Dialogue text ─────────────────────────────────── */
.dialogue-text {
    color: rgb(201, 209, 217);
    font-size: 13px;
    white-space: normal;
    flex-grow: 1;
    margin-top: 4px;
    -unity-text-align: upper-left;
}

/* ── Footer row ────────────────────────────────────── */
.dialogue-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
    border-top-width: 1px;
    border-color: rgb(48, 54, 61);
    padding-top: 4px;
}

/* ── Continue prompt ───────────────────────────────── */
.continue-prompt {
    color: rgb(240, 192, 64);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    opacity: 0;
}

.continue-prompt.visible {
    opacity: 1;
}
